# Local: mongodb://localhost:27017/finsight
# Render/Vercel: MongoDB Atlas URI (allow 0.0.0.0/0 in Network Access)
MONGODB_URI=mongodb://localhost:27017/finsight
MONGODB_DB_NAME=finsight
JWT_SECRET=change_me_to_a_long_random_string
DEMO_EMAIL=demo@finsight.app
DEMO_PASSWORD=demo12345

# Optional public site URL (Vercel/Render) for OpenRouter referer / links
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# OpenAI AI Copilot (preferred when OPENAI_API_KEY is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter fallback (used only if OPENAI_API_KEY is empty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Algorand x402 (Micropayments Track)
ALGORAND_NETWORK=algorand-testnet
# Must be opted-in to testnet USDC ASA 10458941 (use your funded AVM wallet address for local live settle)
PAY_TO=NTKC2CKMWFPFOBWFN23AZ47GHULSWXXFHBL42PJPCWVX7AWIMOUH7SYYOU
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Numeric only (Next.js expands $0 in .env); code prefixes $
X402_PRICE_USDC=0.005
X402_PLAN_PRICE_USDC=0.002
X402_ALLOW_SIMULATION=true
# Optional funded testnet key for live settle (base64 64-byte Algorand key)
# AVM_PRIVATE_KEY=

